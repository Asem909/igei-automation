    {
      "parameters": {
        "jsCode": "const trigger = $('استقبال رسالة واتساب').item.json;\nconst msg = trigger.messages ? trigger.messages[0] : null;\n\n// تجاهل الأحداث اللي مش رسائل (تحديثات حالة: تم الإرسال/التسليم/القراءة)\nif (!msg) {\n  return [];\n}\n\nconst phone = msg.from;\nconst tail = String(phone).replace(/\\D/g, '').slice(-10);\n\n// فحص المحظورين: هل رقم المرسِل موجود في أي خانة في شيت المحظورين؟\nconst blockedRows = $('فحص المحظورين').all();\nconst blocked = blockedRows.some(r =>\n  Object.values(r.json).some(v => {\n    const d = String(v).replace(/\\D/g, '');\n    return d.length >= 10 && d.slice(-10) === tail;\n  })\n);\n\nconst customerRows = $('فحص العميل').all().filter(r => Object.keys(r.json).length > 0);\nconst existing = customerRows.length > 0 ? customerRows[0].json : null;\nconst status = existing ? existing.Status : null;\n\nlet route;\nif (blocked || status === 'closed_no_transfer' || status === 'closed_transfer') {\n  route = 'stop';\n} else if (!existing && msg.type === 'text') {\n  route = 'welcome';\n} else {\n  route = 'agent';\n}\n\nlet agent_input;\nif (msg.type === 'interactive') {\n  const id = msg.interactive.button_reply.id;\n  if (id === 'inquiry') agent_input = 'العميل دوس على زرار: عندي استفسار. ابدأ تجمع بياناته.';\n  else if (id === 'transfer_yes') agent_input = 'العميل دوس على زرار: تحويل لخدمة العملاء. حوله دلوقتي.';\n  else if (id === 'transfer_no') agent_input = 'العميل دوس على زرار: لا شكرًا. سجل بياناته واقفل من غير تحويل.';\n  else agent_input = id;\n} else {\n  agent_input = msg.text?.body || '';\n}\n\nreturn [{ json: { phone, route, agent_input } }];"
      },
